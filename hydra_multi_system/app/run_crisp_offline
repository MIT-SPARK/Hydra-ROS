def setup_pipeline(
    checkpoint, device, width, height, use_rmcc=True, debug_settings=None
):
    opt = BaseExpSettings(dataset_dir="./")  # note: dataset_dir not actually used
    opt.image_size = (height, width)
    opt.checkpoint_path = pathlib.Path(checkpoint).expanduser().absolute()
    opt.use_corrector = False

    # joint nocs & recons model
    model = JointShapePoseNetwork(
        input_dim=3,
        recons_num_layers=5,
        recons_hidden_dim=256,
        recons_modulate_last_layer=True,
        recons_modulate_type="film",
        backbone_model=opt.backbone_model_name,
        local_backbone_model_path=None,
        freeze_pretrained_weights=True,
        backbone_input_res=opt.backbone_input_res,
        nonlinearity=opt.recons_nonlinearity,
        normalization_type=opt.recons_normalization_type,
        nocs_network_type=opt.nocs_network_type,
        nocs_channels=opt.nocs_channels,
        lateral_layers_type=opt.nocs_lateral_layers_type,
        normalize_shape_code=opt.recons_shape_code_normalization,
        recons_shape_code_norm_scale=opt.recons_shape_code_norm_scale,
    )

    state = torch.load(opt.checkpoint_path)
    model.load_state_dict(state["model"])
    model.eval()
    model.backbone.eval()
    model.cuda()

    frame_certifier = FrameCertifier(
        model=model,
        depths_clamp_thres=opt.cert_depths_clamp_thres,
        depths_quantile=opt.cert_depths_quantile,
        depths_eps=opt.cert_depths_eps,
        degen_min_eig_thres=opt.cert_degen_min_eig_thres,
        use_degen_cert=opt.use_degen_cert,
        shape_code_library=None,
    )

    # RMCC verifier - same parameters as online crisp_node
    rmcc_verifier = None
    if use_rmcc:
        rmcc_verifier = ReprojectionMaskConsistencyChecker(
            model=model,
            cube_samples=32,
            cube_scale=3.0,
            projection_radius=1,
            thr_num_pixels_in_mask=0,
            thr_iou=0.0,
            thr_precision=0.21,
            thr_coverage=0.0,
            vis_output=False,
            log_path=None,
        )

    pipeline = Pipeline(
        model=model,
        corrector=None,
        frame_certifier=frame_certifier,
        frame_corrector_mode=opt.frame_corrector_mode,
        pgo_solver=None,
        multi_frame_shape_code_corrector=None,
        multi_frame_geometric_shape_corrector=None,
        device=device,
        rmcc_verifier=rmcc_verifier,
        input_H=opt.image_size[0],
        input_W=opt.image_size[1],
        nr_downsample_before_corrector=opt.pipeline_nr_downsample_before_corrector,
        sdf_input_loss_multiplier=opt.corrector_loss_multiplier,
        registration_inlier_thres=opt.registration_inlier_thres,
        output_intermediate_vars=True,
        output_precrt_results=opt.pipeline_output_precrt_results,
        ssl_batch_size=opt.ssl_batch_size,
        ssl_nocs_clamp_quantile=opt.ssl_nocs_clamp_quantile,
        ssl_augmentation=False,
        ssl_augmentation_type=opt.ssl_augmentation_type,
        ssl_augmentation_gaussian_perturb_std=opt.ssl_augmentation_gaussian_perturb_std,
        no_grad_model_forward=True,
        normalized_recons=True,
        output_degen_condition_number=False,
        normalize_input_image=False,
        shape_code_library=None,
        debug_settings=debug_settings,
    )

    return pipeline, model


def get_image_transform():
    return tvt.Compose(
        [
            tvt.ToImage(),
            tvt.ToDtype(torch.float32, scale=True),
            tvt.Normalize(mean=IMAGENET_DEFAULT_MEAN, std=IMAGENET_DEFAULT_STD),
        ]
    )


def reconstruct_mesh(model, shape_code, s_nocs, cube_samples, cube_scale):
    def callback(coords):
        return model.recons_net.forward(shape_code=shape_code, coords=coords)

    (sdf_grid, voxel_size, voxel_grid_origin) = create_sdf_samples_generic(
        model_fn=callback,
        N=cube_samples,
        max_batch=64**3,
        cube_center=np.array([0, 0, 0]),
        cube_scale=cube_scale,
    )

    mesh = convert_sdf_samples_to_mesh(
        sdf_grid=sdf_grid,
        voxel_grid_origin=voxel_grid_origin,
        voxel_size=voxel_size,
    )

    mesh.vertices *= s_nocs
    return mesh


def depth_to_pointcloud(depth, intrinsics, mask=None):
    """Convert depth image to point cloud in camera frame.

    Args:
        depth: (H, W) depth image in meters
        intrinsics: (3, 3) camera intrinsic matrix
        mask: optional (H, W) mask to filter points

    Returns:
        points: (N, 3) point cloud in camera coordinates
        colors: (N, 3) RGB colors (depth-based colormap)
    """
    if isinstance(depth, torch.Tensor):
        depth = depth.cpu().numpy()
    if isinstance(intrinsics, torch.Tensor):
        intrinsics = intrinsics.cpu().numpy()
    if mask is not None and isinstance(mask, torch.Tensor):
        mask = mask.cpu().numpy()

    h, w = depth.shape
    fx, fy = intrinsics[0, 0], intrinsics[1, 1]
    cx, cy = intrinsics[0, 2], intrinsics[1, 2]

    # Create pixel grid
    u, v = np.meshgrid(np.arange(w), np.arange(h))

    # Apply mask if provided
    if mask is not None:
        valid = (depth > 0) & (mask > 0)
    else:
        valid = depth > 0

    z = depth[valid]
    x = (u[valid] - cx) * z / fx
    y = (v[valid] - cy) * z / fy

    points = np.stack([x, y, z], axis=1)

    # Color by depth (blue=near, red=far)
    z_norm = (z - z.min()) / (z.max() - z.min() + 1e-6)
    colors = plt.cm.viridis(z_norm)[:, :3]

    return points, colors


def transform_mesh_to_camera(mesh, cam_R_nocs, cam_t_nocs, scale):
    """Transform mesh from NOCS frame to camera frame.

    Args:
        mesh: trimesh object with vertices in NOCS frame (already scaled)
        cam_R_nocs: (3, 3) rotation matrix
        cam_t_nocs: (3, 1) translation vector
        scale: scale factor (already applied to mesh)

    Returns:
        vertices_cam: (N, 3) vertices in camera frame
        faces: (M, 3) face indices
    """
    vertices_nocs = np.array(mesh.vertices)  # Already scaled

    # Transform: p_cam = R @ p_nocs + t
    vertices_cam = (cam_R_nocs @ vertices_nocs.T).T + cam_t_nocs.flatten()

    return vertices_cam, np.array(mesh.faces)


def create_rgb_with_mask_overlay(rgb, mask, alpha=0.4):
    """Create RGB image with semi-transparent mask overlay.

    Args:
        rgb: (H, W, 3) RGB image (uint8 or float)
        mask: (H, W) binary mask
        alpha: overlay transparency

    Returns:
        overlay: (H, W, 3) RGB image with mask overlay
    """
    if isinstance(rgb, torch.Tensor):
        rgb = rgb.cpu().numpy()
    if isinstance(mask, torch.Tensor):
        mask = mask.cpu().numpy()

    # Ensure RGB is in [0, 255] range
    if rgb.max() <= 1.0:
        rgb = (rgb * 255).astype(np.uint8)
    else:
        rgb = rgb.astype(np.uint8)

    # Create overlay
    overlay = rgb.copy()
    mask_bool = mask > 0

    # Green overlay for mask region
    overlay[mask_bool, 0] = np.clip(overlay[mask_bool, 0] * (1 - alpha), 0, 255)
    overlay[mask_bool, 1] = np.clip(
        overlay[mask_bool, 1] * (1 - alpha) + 255 * alpha, 0, 255
    )
    overlay[mask_bool, 2] = np.clip(overlay[mask_bool, 2] * (1 - alpha), 0, 255)

    return overlay


def create_rmcc_overlay(mask_obs, proj_mask):
    """Create RMCC comparison overlay image.

    Colors:
    - Green: intersection (both masks agree) - correct projection
    - Red: observed only (false negative) - underestimation
    - Blue: projected only (false positive) - overestimation

    Args:
        mask_obs: (H, W) observed mask
        proj_mask: (H, W) projected mask

    Returns:
        overlay: (H, W, 3) RGB overlay image
    """
    if isinstance(mask_obs, torch.Tensor):
        mask_obs = mask_obs.cpu().numpy()
    if isinstance(proj_mask, torch.Tensor):
        proj_mask = proj_mask.cpu().numpy()

    mask_obs = mask_obs > 0
    proj_mask = proj_mask > 0

    h, w = mask_obs.shape
    overlay = np.zeros((h, w, 3), dtype=np.uint8)

    intersection = mask_obs & proj_mask
    obs_only = mask_obs & ~proj_mask
    proj_only = proj_mask & ~mask_obs

    overlay[intersection] = [0, 255, 0]  # Green: correct
    overlay[obs_only] = [255, 0, 0]  # Red: false negative (underestimation)
    overlay[proj_only] = [0, 0, 255]  # Blue: false positive (overestimation)

    return overlay


def visualize_with_viser(
    rgb,
    depth,
    mask,
    intrinsics,
    mesh,
    cam_R_nocs,
    cam_t_nocs,
    scale,
    surface_points_nocs,
    proj_mask,
    metrics,
    port=8080,
):
    """Launch viser server for interactive 3D visualization.

    Visualizes:
    - Camera coordinate frame with RMCC overlay as frustum image
    - Depth point cloud (camera frame)
    - Reconstructed mesh (camera frame)
    - Surface points used for RMCC (camera frame)
    - 2D images: RGB with mask, RMCC overlay
    """
    server = viser.ViserServer(port=port)
    click.secho(
        f"Viser server started at http://localhost:{port}", fg="green", bold=True
    )

    # Transform mesh to camera frame
    vertices_cam, faces = transform_mesh_to_camera(mesh, cam_R_nocs, cam_t_nocs, scale)

    # Transform surface points to camera frame
    # surface_points_nocs are already scaled
    cam_T_nocs = np.eye(4)
    cam_T_nocs[:3, :3] = cam_R_nocs
    cam_T_nocs[:3, 3] = cam_t_nocs.flatten()

    # Get depth point cloud
    depth_points, depth_colors = depth_to_pointcloud(depth, intrinsics, mask)

    # Create 2D visualizations
    rgb_np = rgb.cpu().numpy() if isinstance(rgb, torch.Tensor) else rgb
    mask_np = mask.cpu().numpy() if isinstance(mask, torch.Tensor) else mask

    # RGB with mask overlay
    rgb_overlay = create_rgb_with_mask_overlay(rgb_np, mask_np)

    # RMCC comparison overlay
    rmcc_overlay = create_rmcc_overlay(mask_np, proj_mask)

    # Get image dimensions and intrinsics for frustum
    if isinstance(intrinsics, torch.Tensor):
        intrinsics_np = intrinsics.cpu().numpy()
    else:
        intrinsics_np = intrinsics
    h, w = mask_np.shape
    fy = intrinsics_np[1, 1]
    fov = 2 * np.arctan2(h / 2, fy)

    # Add coordinate frame at origin (camera frame)
    server.scene.add_frame(
        "/camera",
        wxyz=(1, 0, 0, 0),
        position=(0, 0, 0),
        axes_length=0.1,
        axes_radius=0.005,
    )

    # Add camera frustum with RMCC overlay image at the origin
    # The mesh is in camera coordinates, so the camera is at origin
    server.scene.add_camera_frustum(
        "/camera/frustum_rmcc",
        fov=fov,
        aspect=w / h,
        scale=0.5,  # Adjust scale for better visibility
        image=rmcc_overlay,
        line_width=1.5,
        color=(154, 160, 166),  # White frustum lines
    )

    # Add depth point cloud
    server.scene.add_point_cloud(
        "/depth_pointcloud",
        points=depth_points.astype(np.float32),
        colors=depth_colors.astype(np.float32),
        point_size=0.01,
        point_shape="circle",
    )

    # Add reconstructed mesh
    server.scene.add_mesh_trimesh(
        "/reconstructed_mesh",
        mesh=mesh,
        position=cam_t_nocs.flatten().astype(np.float32),
        wxyz=vtf.SO3.from_matrix(cam_R_nocs).wxyz.astype(np.float32),
    )

    # Add surface points (used for RMCC projection)
    # surface_colors = np.full((len(surface_points_cam), 3), [1.0, 0.5, 0.0], dtype=np.float32)  # Orange
    # server.scene.add_point_cloud(
    #     "/surface_points",
    #     points=surface_points_cam.astype(np.float32),
    #     colors=surface_colors,
    #     point_size=0.005,
    #     point_shape="circle",
    # )

    # Add GUI folder for 2D images and controls
    with server.gui.add_folder("2D Visualizations"):
        server.gui.add_markdown(
            f"**RMCC Metrics:**\n"
            f"- IoU: {metrics['iou']:.3f}\n"
            f"- Coverage: {metrics['coverage']:.3f}\n"
            f"- Precision: {metrics['precision']:.3f}\n\n"
            f"**Frustum Legend:**\n"
            f"- Green: Intersection (correct)\n"
            f"- Red: Observed only (underestimation)\n"
            f"- Blue: Projected only (overestimation)"
        )

    click.secho("\nVisualization Controls:", fg="cyan")
    click.secho("  - Left click + drag: Rotate view", fg="white")
    click.secho("  - Right click + drag: Pan view", fg="white")
    click.secho("  - Scroll: Zoom in/out", fg="white")
    click.secho(
        "\nFrustum shows RMCC overlay (Green=correct, Red=underest, Blue=overest)",
        fg="cyan",
    )
    click.secho("\nPress Ctrl+C to exit...", fg="yellow")

    return server, rgb_overlay, rmcc_overlay


def save_paper_figures(
    rgb,
    depth,
    mask,
    intrinsics,
    mesh,
    cam_R_nocs,
    cam_t_nocs,
    scale,
    surface_points_nocs,
    proj_mask,
    metrics,
    output_dir,
):
    """Save figures for the RMCC methodology section.

    Saves:
    1. rgb.png - Raw RGB image
    2. rgb_with_mask.png - RGB image with observed mask overlay
    3. depth_colormap.png - Depth visualization with colorbar
    4. mask_observed.png - Observed mask (raw)
    5. mask_projected.png - Projected mask (raw)
    6. rmcc_overlay.png - RMCC overlay (raw)
    7. rmcc_comparison.png - Three-panel: [Observed | Projected | Overlay]
    8. metrics.txt - RMCC metrics
    """
    from PIL import Image

    output_dir = pathlib.Path(output_dir)
    output_dir.mkdir(parents=True, exist_ok=True)

    rgb_np = rgb.cpu().numpy() if isinstance(rgb, torch.Tensor) else rgb
    mask_np = mask.cpu().numpy() if isinstance(mask, torch.Tensor) else mask
    depth_np = depth.cpu().numpy() if isinstance(depth, torch.Tensor) else depth

    # 1. Raw RGB image
    rgb_uint8 = (
        (rgb_np * 255).astype(np.uint8)
        if rgb_np.max() <= 1.0
        else rgb_np.astype(np.uint8)
    )
    Image.fromarray(rgb_uint8).save(output_dir / "rgb.png")
    click.secho(f"Saved: {output_dir / 'rgb.png'}", fg="green")

    # 2. RGB with mask overlay
    rgb_overlay = create_rgb_with_mask_overlay(rgb_np, mask_np, alpha=0.3)
    Image.fromarray(rgb_overlay).save(output_dir / "rgb_with_mask.png")
    click.secho(f"Saved: {output_dir / 'rgb_with_mask.png'}", fg="green")

    # 3. Depth visualization (colormap with colorbar via matplotlib)
    plt.rcParams["font.family"] = "serif"
    plt.rcParams["font.serif"] = ["Times New Roman"]
    fig, ax = plt.subplots(figsize=(8, 6), dpi=300)
    depth_masked = np.where(mask_np > 0, depth_np, np.nan)
    im = ax.imshow(depth_masked, cmap="viridis")
    ax.axis("off")
    cbar = plt.colorbar(im, ax=ax, fraction=0.046, pad=0.04)
    cbar.set_label("depth [m]", fontsize=12)
    plt.tight_layout()
    plt.savefig(output_dir / "depth_colormap.png", bbox_inches="tight", pad_inches=0.1)
    plt.savefig(output_dir / "depth_colormap.pdf", bbox_inches="tight", pad_inches=0.1)
    plt.close()
    click.secho(f"Saved: {output_dir / 'depth_colormap.pdf'}", fg="green")

    # 4. Observed mask (raw, no title)
    mask_img = (
        (mask_np * 255).astype(np.uint8)
        if mask_np.max() <= 1.0
        else mask_np.astype(np.uint8)
    )
    Image.fromarray(mask_img, mode="L").save(output_dir / "mask_observed.png")
    click.secho(f"Saved: {output_dir / 'mask_observed.png'}", fg="green")

    # 5. Projected mask (raw, no title)
    proj_mask_img = proj_mask.astype(np.uint8) * 255
    Image.fromarray(proj_mask_img, mode="L").save(output_dir / "mask_projected.png")
    click.secho(f"Saved: {output_dir / 'mask_projected.png'}", fg="green")

    # 6. RMCC overlay (raw, no title)
    rmcc_overlay = create_rmcc_overlay(mask_np, proj_mask)
    Image.fromarray(rmcc_overlay).save(output_dir / "rmcc_overlay.png")
    click.secho(f"Saved: {output_dir / 'rmcc_overlay.png'}", fg="green")

    # 7. RMCC comparison (three-panel)
    rmcc_img = make_hconcat_mask_image(mask_np, proj_mask, metrics)
    fig, ax = plt.subplots(figsize=(15, 5), dpi=300)
    ax.imshow(rmcc_img)
    ax.set_title(
        r"RMCC Verification: $\mathcal{M}_{\mathrm{obs}}$ (left) | "
        r"$\mathcal{M}_{\mathrm{proj}}$ (center) | "
        r"Overlay (right)",
        fontsize=14,
    )
    ax.axis("off")

    from matplotlib.patches import Patch

    legend_elements = [
        Patch(facecolor="green", label="Intersection (correct)"),
        Patch(facecolor="red", label="Obs only (underestimation)"),
        Patch(facecolor="blue", label="Proj only (overestimation)"),
    ]
    ax.legend(handles=legend_elements, loc="upper right", fontsize=10)

    plt.tight_layout()
    plt.savefig(output_dir / "rmcc_comparison.png", bbox_inches="tight", pad_inches=0.1)
    plt.close()
    click.secho(f"Saved: {output_dir / 'rmcc_comparison.png'}", fg="green")

    # 8. Save metrics to text file
    with open(output_dir / "metrics.txt", "w") as f:
        f.write("RMCC Metrics\n")
        f.write("=" * 40 + "\n")
        f.write(f"IoU:       {metrics['iou']:.6f}\n")
        f.write(f"Coverage:  {metrics['coverage']:.6f}\n")
        f.write(f"Precision: {metrics['precision']:.6f}\n")
    click.secho(f"Saved: {output_dir / 'metrics.txt'}", fg="green")

    click.secho(f"\nAll figures saved to: {output_dir}", fg="cyan", bold=True)


# Legacy visualization function (matplotlib-based)
def show_nocs(rgb, mask, mesh, nocs_pts, orig):
    mask_j = torch.broadcast_to(mask, nocs_pts.shape)
    nocs_pts_in = nocs_pts[mask_j].reshape(3, -1)  # in segmentation mask
    nocs_pts_out = nocs_pts[~mask_j].reshape(3, -1)

    # visualize NOCS and object mesh points
    object_pc = torch.tensor(mesh.vertices)

    nocs_mesh_img = visualize_pcs_pyvista_headless(
        [nocs_pts_in, nocs_pts_out, object_pc],
        colors=["lightblue", "red", "black"],
        pt_sizes=[10.0, 10.0, 2.0],
    )

    fig, axs = plt.subplots(2, 4, figsize=(20, 20))
    rgb[0, ...] = rgb[0, ...] * 0.229 + 0.485
    rgb[1, ...] = rgb[1, ...] * 0.224 + 0.456
    rgb[2, ...] = rgb[2, ...] * 0.225 + 0.406
    axs[0, 0].imshow(rgb.permute(1, 2, 0).numpy())
    axs[0, 0].set_title("image")
    sns.heatmap(
        data=nocs_pts[0].cpu().numpy(),
        cbar_kws={"pad": 0.02},
        ax=axs[0, 1],
        square=True,
        xticklabels=False,
        yticklabels=False,
    )
    axs[0, 1].set_title("x heatmap")
    sns.heatmap(
        data=nocs_pts[1].cpu().numpy(),
        cbar_kws={"pad": 0.02},
        ax=axs[1, 0],
        square=True,
        xticklabels=False,
        yticklabels=False,
    )
    axs[1, 0].set_title("y heatmap")
    sns.heatmap(
        data=nocs_pts[2].cpu().numpy(),
        cbar_kws={"pad": 0.02},
        ax=axs[1, 1],
        square=True,
        xticklabels=False,
        yticklabels=False,
    )
    axs[1, 1].set_title("z heatmap")
    axs[0, 2].imshow(nocs_mesh_img)
    axs[1, 2].imshow(orig[0])
    axs[0, 3].imshow(orig[1])
    axs[1, 3].imshow(orig[2], cmap="gray")

    plt.show()


@click.command()
@click.argument("checkpoint", type=click.Path(exists=True))
@click.argument("input_path", type=click.Path(exists=True))
@click.option("--device", "-d", default="cuda", type=str)
@click.option("--cube-samples", "-n", default=128, type=int)
@click.option("--cube-scale", "-l", default=3.0, type=float)
@click.option(
    "--show-inputs", "-s", is_flag=True, help="Show input images before processing"
)
@click.option(
    "--use-rmcc/--no-rmcc",
    default=True,
    help="Enable/disable RMCC verifier (default: enabled)",
)
@click.option(
    "--use-viser", "-V", is_flag=True, help="Use viser for interactive 3D visualization"
)
@click.option("--viser-port", default=8080, type=int, help="Port for viser server")
@click.option(
    "--save-figures", "-o", type=click.Path(), help="Output directory for paper figures"
)
@click.option(
    "--legacy-vis", is_flag=True, help="Use legacy matplotlib/pyvista visualization"
)
def main(
    checkpoint,
    input_path,
    device,
    cube_samples,
    cube_scale,
    show_inputs,
    use_rmcc,
    use_viser,
    viser_port,
    save_figures,
    legacy_vis,
):
    """Run CRISP on images with paper-quality visualization.

    Examples:

        # Basic run with RMCC
        run_crisp_offline checkpoint.pth input.pt

        # Interactive 3D visualization with viser
        run_crisp_offline checkpoint.pth input.pt --use-viser

        # Save paper figures
        run_crisp_offline checkpoint.pth input.pt -o ./figures

        # Legacy visualization (matplotlib)
        run_crisp_offline checkpoint.pth input.pt --legacy-vis
    """
    # Check viser availability if requested
    if use_viser and not VISER_AVAILABLE:
        click.secho(
            "ERROR: viser is not available. Install with: pip install viser",
            fg="red",
            bold=True,
        )
        click.secho("Falling back to matplotlib visualization.", fg="yellow")
        use_viser = False
        legacy_vis = True

    checkpoint = pathlib.Path(checkpoint).expanduser().resolve()
    input_path = pathlib.Path(input_path).expanduser().resolve()
    tensors = torch.load(input_path, weights_only=False)

    rgb = tensors["rgb"]
    width = rgb.shape[1]
    height = rgb.shape[0]

    depth = tensors["depth"]
    mask = tensors["mask"]
    intrinsics = tensors["intrinsics"]

    if show_inputs:
        with np.printoptions(suppress=True):
            print(f"Intrinsics:\n{intrinsics.numpy()}")

        fig, ax = plt.subplots(1, 3, figsize=(15, 5))
        ax[0].imshow(rgb)
        ax[0].set_title("RGB")
        ax[1].imshow(depth)
        ax[1].set_title("Depth")
        ax[2].imshow(mask, cmap="gray")
        ax[2].set_title("Mask")
        plt.tight_layout()
        plt.show()

    click.secho(f"Loading model checkpoint from {checkpoint}...", fg="green")
    click.secho(f"RMCC verifier: {'enabled' if use_rmcc else 'disabled'}", fg="cyan")
    debug_settings = {
        "vis_input_batched_pcs": False,
        "vis_input_cropped_pcs": False,
        "vis_input_sampled_pcs": False,
        "vis_nocs": False,
        "vis_precorrector_nocs_with_sdf": False,
        "vis_postcorrector_nocs_with_sdf": False,
        "vis_precorrector_transformed_nocs": False,
        "vis_postcorrector_transformed_nocs": False,
        "vis_sdf_slices": False,
        "vis_mf_geometric_corrector": False,
        "vis_sdf_grid_scale": 1,
        "save_nocs_output": False,
    }
    pipeline, model = setup_pipeline(
        checkpoint,
        device,
        width=width,
        height=height,
        use_rmcc=use_rmcc,
        debug_settings=debug_settings,
    )
    click.secho("Finished loading model checkpoint and pipeline", fg="green")

    rgb_transformed = get_image_transform()(rgb)
    if isinstance(depth, torch.Tensor):
        # If depth is integer-typed (often mm), cast to float first.
        if not depth.is_floating_point():
            depth = depth.to(torch.float32)

            # NOTE(hlim): Heuristic - if values look like millimeters, convert to meters.
            # (Typical meter depths are < 50; mm depths are often > 1000.)
            with torch.no_grad():
                max_val = float(depth.max().item()) if depth.numel() > 0 else 0.0
            if max_val > 50.0:
                depth = depth * 1.0e-3
        else:
            depth = depth.to(torch.float32)

    bboxes = tops.masks_to_boxes(mask.unsqueeze(0))
    obj_info = [
        [{"label": "1", "bbox": bboxes[0, ...].int().tolist(), "id_in_segm": 255}]
    ]

    with torch.no_grad():
        payload = pipeline(
            rgbs=rgb_transformed[None, ...].to(device),
            masks=mask[None, None, ...].to(device),
            depths=depth[None, None, ...].to(device),
            intrinsics=intrinsics[None, None, ...].to(device),
            objs=obj_info,
            frames_info=[{"inst_count": 1}],
        )

        # Display verification results
        is_valid = payload.get("is_valid", True)
        if use_rmcc:
            if is_valid:
                click.secho("RMCC Verification: PASSED", fg="green", bold=True)
            else:
                click.secho("RMCC Verification: FAILED", fg="red", bold=True)

        scale = payload["cam_s_nocs"][0, ...].item()
        cam_R_nocs = payload["cam_R_nocs"][0, :3, :3].cpu().numpy()
        cam_t_nocs = payload["cam_t_nocs"][0, ...].cpu().numpy()

        click.secho(f"Scale (cam_s_nocs): {scale:.4f}", fg="cyan")

        # Reconstruct mesh (high resolution for visualization)
        vec = payload["shape_code"]
        mesh = reconstruct_mesh(model, vec, scale, cube_samples, cube_scale)

        # Reconstruct a separate mesh with RMCC parameters (cube_samples=32, cube_scale=3.0)
        # for surface point sampling. This matches the parameters used in crisp_node's
        # RMCC verifier. The mesh is filtered (no degenerate faces, duplicate faces,
        # or floating components) by convert_sdf_samples_to_mesh.
        rmcc_cube_samples = 32
        rmcc_cube_scale = 3.0
        rmcc_mesh = reconstruct_mesh(
            model, vec, scale, rmcc_cube_samples, rmcc_cube_scale
        )

        # Use mesh vertices as surface points (these are already filtered)
        surface_points_nocs = np.array(rmcc_mesh.vertices)

        # Build projection mask and compute metrics
        intrinsics_np = intrinsics.cpu().numpy()
        mask_np = mask.cpu().numpy()

        cam_T_nocs = np.eye(4)
        cam_T_nocs[:3, :3] = cam_R_nocs
        cam_T_nocs[:3, 3] = cam_t_nocs.flatten()

        proj_mask = build_projection_mask(
            surface_points_nocs,
            cam_T_nocs,
            intrinsics_np,
            mask_np.shape,
            radius=1,
        )
        metrics = compute_projection_metrics(proj_mask, mask_np)

        click.secho("\nRMCC Metrics:", fg="cyan", bold=True)
        click.secho(f"  IoU:       {metrics['iou']:.4f}", fg="white")
        click.secho(f"  Coverage:  {metrics['coverage']:.4f}", fg="white")
        click.secho(f"  Precision: {metrics['precision']:.4f}", fg="white")

        # Save paper figures if requested
        if save_figures:
            save_paper_figures(
                rgb,
                depth,
                mask,
                intrinsics,
                mesh,
                cam_R_nocs,
                cam_t_nocs,
                scale,
                surface_points_nocs,
                proj_mask,
                metrics,
                save_figures,
            )

        # Interactive viser visualization
        if use_viser:
            server, rgb_overlay, rmcc_overlay = visualize_with_viser(
                rgb,
                depth,
                mask,
                intrinsics,
                mesh,
                cam_R_nocs,
                cam_t_nocs,
                scale,
                surface_points_nocs,
                proj_mask,
                metrics,
                port=viser_port,
            )

            # Save 2D images for reference
            if save_figures:
                from PIL import Image

                output_dir = pathlib.Path(save_figures)
                Image.fromarray(rgb_overlay).save(output_dir / "rgb_overlay_viser.png")
                Image.fromarray(rmcc_overlay).save(
                    output_dir / "rmcc_overlay_viser.png"
                )

            try:
                while True:
                    pass
            except KeyboardInterrupt:
                click.secho("\nShutting down viser server...", fg="yellow")

        # Legacy visualization
        elif legacy_vis:
            show_nocs(
                payload["processed_imgs"][0].cpu(),
                payload["processed_mask"][0].cpu(),
                mesh,
                torch.squeeze(payload["nocs_map"]),
                (tensors["rgb"], depth, mask),
            )

        # Default: show matplotlib figures if no visualization option selected
        elif not save_figures:
            # Show RMCC comparison
            rmcc_img = make_hconcat_mask_image(mask_np, proj_mask, metrics)

            fig, axes = plt.subplots(2, 2, figsize=(14, 10))

            # RGB with mask overlay
            rgb_overlay = create_rgb_with_mask_overlay(rgb.numpy(), mask_np)
            axes[0, 0].imshow(rgb_overlay)
            axes[0, 0].set_title("RGB with Observed Mask", fontsize=12)
            axes[0, 0].axis("off")

            # Depth
            axes[0, 1].imshow(depth.numpy(), cmap="viridis")
            axes[0, 1].set_title("Depth Image", fontsize=12)
            axes[0, 1].axis("off")

            # RMCC comparison
            axes[1, 0].imshow(rmcc_img)
            axes[1, 0].set_title(
                f"RMCC: Obs | Proj | Overlay (Precision: {metrics['precision']:.3f})",
                fontsize=12,
            )
            axes[1, 0].axis("off")

            # Mesh visualization (headless pyvista)
            object_pc = torch.tensor(mesh.vertices)
            mesh_img = visualize_pcs_pyvista_headless(
                [object_pc],
                colors=["steelblue"],
                pt_sizes=[3.0],
            )
            axes[1, 1].imshow(mesh_img)
            axes[1, 1].set_title(
                f"Reconstructed Mesh (scale: {scale:.3f})", fontsize=12
            )
            axes[1, 1].axis("off")

            plt.tight_layout()
            plt.show()


if __name__ == "__main__":
    main()
